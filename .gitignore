# ==========================================
# Node.js + React (Vite) .gitignore
# ==========================================

# Dependencies
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/

# Build & Output directories
dist/
dist-ssr/
build/
*.local

# Vite cache
.vite/
.cache/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Testing & Coverage
coverage/
.nyc_output/

# Editor directories & files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
